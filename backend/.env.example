# AI API Keys configuration for AI ADS Studio
# Copy this file to .env and add your API keys there.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Optional: choose another local Piper model or Python interpreter.
# PIPER_MODEL_PATH=models/vi_VN-vais1000-medium.onnx
# PIPER_PYTHON=python

# Hoặc nhập API Key của Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Port cho Go Backend (mặc định 8080)
PORT=8080

# Tài khoản quản trị dùng để đăng nhập vào AI ADS Studio.
# Đặt mật khẩu riêng dài ít nhất 12 ký tự.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters

# Origin của frontend; nhiều origin có thể phân tách bằng dấu phẩy.
FRONTEND_ORIGINS=http://localhost:5173